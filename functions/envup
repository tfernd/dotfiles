# Load KEY=VALUE pairs from a .env file into the current shell
# SECURITY: parses assignments only; the file is never sourced as shell code.
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo -e "📝 \033[1;33mUsage:\033[0m envup [file (default: .env)]"
    return 0
fi

local envfile="${1:-.env}"
if [[ ! -f "$envfile" ]]; then
    echo "❌ No $envfile file found."
    return 1
fi

local line key val count=0
while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip blanks, comments and anything that isn't KEY=VALUE
    [[ "$line" =~ '^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$' ]] || continue
    key="$match[1]"
    val="$match[2]"
    # Strip one pair of surrounding quotes
    if [[ "$val" == \"*\" || "$val" == \'*\' ]] && (( ${#val} >= 2 )); then
        val="${val[2,-2]}"
    fi
    export "$key=$val"
    (( count++ ))
done < "$envfile"
echo "✅ Loaded $count variables from $envfile"
