# Remove Python caches and build leftovers below the current directory
# Skips .git, virtualenvs and node_modules. Whole cache dirs are removed
# (find -delete can't remove non-empty dirs). find -exec runs the real rm
# binary, not the trash wrapper.
find . \( -name .git -o -name .venv -o -name venv -o -name node_modules \) -prune -o \
    -type d \( \
        -name "__pycache__"   -o \
        -name ".pytest_cache" -o \
        -name ".mypy_cache"   -o \
        -name ".ruff_cache"   -o \
        -name ".ipynb_checkpoints" -o \
        -name "*.egg-info"    -o \
        -name ".eggs"         -o \
        -name ".tox"          -o \
        -name ".nox"          -o \
        -name "htmlcov" \
    \) -prune -exec rm -rf {} + -o \
    -type f \( -name "*.pyc" -o -name "*.pyo" -o -name ".coverage" \) -exec rm -f {} + 2>/dev/null

# build/ and dist/ are generic names: only remove them at the root of a Python project
if [[ -f pyproject.toml || -f setup.py || -f setup.cfg ]]; then
    command rm -rf ./build ./dist
fi
echo "🧹 Cleaned Python cache and temp files."
