# ============================================================================
# 🚀 TERMINAL CHEATSHEET
# ============================================================================

# --- help git: the Starship git-pill guide ---
if [[ "${1:-}" == "git" ]]; then
    echo -e "\n\033[1;36m=================================================================\033[0m"
    echo -e "\033[1;35m  🐙 GIT PROMPT & STATUS GUIDE\033[0m"
    echo -e "\033[1;36m=================================================================\033[0m\n"

    echo -e "\033[1;34m🔍 PROMPT STRUCTURE BREAKDOWN\033[0m"
    echo -e "  \033[1;37m user   …/dotfiles   main  [ ●6 ○20 ✕16 ▲2 ] +584 -3101\033[0m\n"
    echo -e "  \033[1;33m main\033[0m                  ➔ Current Branch Name"
    echo -e "  \033[1;33m[ ●6 ○20 ✕16 ▲2 ]\033[0m       ➔ Status Box (File & Sync indicators)"
    echo -e "  \033[1;33m+584 -3101\033[0m              ➔ Line Diff (+lines added, -lines deleted)"

    echo -e "\n\033[1;34m📋 STATUS BOX SYMBOLS ([ ... ])\033[0m"
    echo -e "  \033[1;33m●\033[0m   \033[38;5;244m<count>\033[0m   : Staged files ready to commit (added with 'git add')"
    echo -e "  \033[1;33m○\033[0m   \033[38;5;244m<count>\033[0m   : Modified files with unstaged local edits"
    echo -e "  \033[1;33m✕\033[0m   \033[38;5;244m<count>\033[0m   : Deleted files (removed from disk)"
    echo -e "  \033[1;33m?\033[0m   \033[38;5;244m<count>\033[0m   : Untracked brand new files (not yet in git)"
    echo -e "  \033[1;33m▲\033[0m   \033[38;5;244m<count>\033[0m   : Ahead — local commits waiting to be pushed ('git push')"
    echo -e "  \033[1;33m▼\033[0m   \033[38;5;244m<count>\033[0m   : Behind — new commits on remote waiting to be pulled ('git pull')"
    echo -e "  \033[1;33m⇄\033[0m   \033[38;5;244m▲X ▼Y\033[0m     : Diverged — both you (▲X) and remote (▼Y) have new commits"
    echo -e "  \033[1;33m▪\033[0m   \033[38;5;244m<count>\033[0m   : Stashed change sets saved with 'git stash'"
    echo -e "  \033[1;33m!\033[0m   \033[38;5;244m<count>\033[0m   : Merge conflicts with unresolved conflict markers"
    echo -e "  \033[1;33m→\033[0m   \033[38;5;244m<count>\033[0m   : Renamed or moved files"

    echo -e "\n\033[1;34m🏷️ COMMIT & STATE ALERTS\033[0m"
    # 󰜘 /  render 1 cell narrower than the other Nerd icons — extra space after those two icons.
    printf "  \033[1;35m%s  %-10s\033[0m : %s\n" "󰜘" "DETACHED"  "Pill shown only when checked out to a commit SHA or tag"
    printf "  \033[1;35m%s  %-10s\033[0m : %s\n" "" "<tag>"     "Active release tag name (e.g.  v1.2.0)"
    printf "  \033[1;35m%s %-10s\033[0m : %s\n"  "" "REBASING"  "Active git rebase in progress (shows step X/Y)"
    printf "  \033[1;35m%s %-10s\033[0m : %s\n"  "" "MERGING"   "Active merge resolution in progress"
    printf "  \033[1;35m%s %-10s\033[0m : %s\n"  "" "PICKING"   "Active git cherry-pick in progress"
    printf "  \033[1;35m%s %-10s\033[0m : %s\n"  "" "REVERTING" "Active git revert in progress"
    printf "  \033[1;35m%s %-10s\033[0m : %s\n"  "" "BISECTING" "Active git bisect binary search in progress"

    echo -e "\n\033[1;36m=================================================================\033[0m\n"
    return 0 2>/dev/null || exit 0
fi

echo -e "\n\033[1;36m=================================================================\033[0m"
echo -e "\033[1;35m  🚀 TERMINAL CHEATSHEET\033[0m"
echo -e "\033[1;36m=================================================================\033[0m\n"

print_cmd() { printf "  \033[1;32m%-15s\033[0m : %s\n" "$1" "$2"; }

echo -e "\033[1;33m📂 FILES & NAVIGATION\033[0m"
[[ "$HAS_ZOXIDE" == "true" ]] && print_cmd "cd" "Smarter cd (zoxide)"
print_cmd ".., ~" "Go up 1 level, or Home"
print_cmd "-" "Jump to the last directory you were in"
print_cmd "ls" "Plain ls (never aliased)"
if [[ "$HAS_EZA" == "true" ]]; then
    print_cmd "ll, lt" "eza views (ll = long, lt = tree)"
    print_cmd "l" "Colourful listing (eza, icons); ls stays plain"
    print_cmd "lsh, llh, lth" "Same but shows hidden files"
fi
[[ "$HAS_BAT" == "true" ]] && print_cmd "cat" "Modern cat with syntax highlighting (bat)"
print_cmd "extract" "Unpack one archive (tar, zip, 7z, rar, deb, rpm, gz...) [dest]"
print_cmd "compress" "Make an archive from the extension (default .tar.gz); never overwrites"

echo -e "\n\033[1;33m🔍 SEARCH & SYSTEM\033[0m"
[[ "$HAS_ATUIN" == "true" ]] && print_cmd "Ctrl+R / ↑" "Interactive shell history (atuin)"
print_cmd "c" "Clear terminal"
print_cmd "myip, localip" "Public and local IP"
print_cmd "reload, x" "Reload shell, Exit"

echo -e "\n\033[1;33m🐙 GIT & GITHUB\033[0m"
if [[ "$HAS_GH" == "true" ]]; then
    print_cmd "ghv" "View repo in browser"
fi


echo -e "\n\033[1;33m🛡️ SETUP & MANAGEMENT\033[0m"
print_cmd "git-setup" "Git identity wizard"
print_cmd "ssh-setup" "SSH key wizard"
print_cmd "refresh" "Rebuild cache + reload shell"
print_cmd "doctor" "Health check (tools, configs, caches)"
print_cmd "dotdoctor" "Pins, CVE advisories (check), local scan (scan)"
print_cmd "dotdoctor help" "Which dotdoctor command does what"
print_cmd "dotdoctor check --latest" "Also ask GitHub for releases past the quarantine"
print_cmd "dotdoctor check --advisories" "Ask OSV.dev about each tool's installed version"
print_cmd "dotdoctor update" "What can be updated or removed, and the commands"
print_cmd "dotdoctor update --apply" "Ask y/n/a/q before each update step"
print_cmd "dotdoctor scan --deep" "Local scan plus package file verification (slow)"
print_cmd "dotdoctor clean" "Dangling units, git rewrites, old Brotli, duplicate tool copies"
print_cmd "sudok" "Forget cached sudo credentials"
[[ "$HAS_TRASH" == "true" ]] && print_cmd "rm, del" "Move to Trash (safe)"
[[ "$HAS_TRASH" == "true" ]] && print_cmd "rl, rt" "List trash, Restore from trash"
[[ "$HAS_TRASH" == "true" ]] && print_cmd "empty-trash" "Empty trash (with preview)"

echo -e "\n\033[1;36m=================================================================\033[0m\n"
