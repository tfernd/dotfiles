# ============================================================================
# 📊 ADVANCED GITHUB LEAD DASHBOARD (gstats / gstat)
# Works across standard GitHub and GitHub Enterprise
# ============================================================================

# Ensure gh is authenticated (auto-detects active host: github.com or GH Enterprise)
if ! gh auth status >/dev/null 2>&1; then
    echo -e "\n❌ \033[1;31mNot logged into GitHub CLI.\033[0m Run 'gh auth login' to authenticate.\n"
    return 1
fi

local user=$(gh api user --jq '.login' 2>/dev/null || echo "@me")
local host=$(gh auth status 2>&1 | grep -oE 'Logged in to [^ ]+' | head -1 | awk '{print $NF}')
[[ -z "$host" ]] && host="github.com"

echo -e "\n\033[1;36m═══════════════════════════════════════════════════════════════════════\033[0m"
echo -e "\033[1;35m  📊 GITHUB LEAD DASHBOARD — $user \033[0;37m($host)\033[0m"
echo -e "\033[1;36m═══════════════════════════════════════════════════════════════════════\033[0m"

# -----------------------------------------------------------------------------
# 1. PRs WAITING FOR YOUR REVIEW (Action Items for Lead)
# -----------------------------------------------------------------------------
echo -e "\n\033[1;33m👀 PRs AWAITING YOUR REVIEW\033[0m"
local review_prs=$(gh search prs --review-requested=@me --state=open --json repository,number,title,updatedAt,url --jq '.[] | "\(.repository.nameWithOwner)\t#\(.number)\t\(.title)\t\(.updatedAt)\t\(.url)"' 2>/dev/null)

if [[ -n "$review_prs" ]]; then
    printf "  \033[1;37m%-28s %-8s %-32s %-12s\033[0m\n" "REPO" "PR" "TITLE" "STALENESS"
    echo "  -------------------------------------------------------------------------------"
    local now_ts=$(date +%s)
    echo "$review_prs" | while IFS=$'\t' read -r repo pr_num title updated_at url; do
        local pr_ts=$(date -d "$updated_at" +%s 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%SZ" "$updated_at" +%s 2>/dev/null || echo "$now_ts")
        local diff_days=$(( (now_ts - pr_ts) / 86400 ))
        local stale_badge="\033[1;32m${diff_days}d ago\033[0m"
        (( diff_days >= 3 )) && stale_badge="\033[1;33m${diff_days}d (waiting)\033[0m"
        (( diff_days >= 7 )) && stale_badge="\033[1;31m🔥 ${diff_days}d STALE\033[0m"

        local short_title="${title[1,30]}"
        [[ ${#title} -gt 30 ]] && short_title="${short_title}…"
        printf "  \033[1;34m%-28s\033[0m \033[1;36m%-8s\033[0m %-32s %b\n" "${repo[1,27]}" "$pr_num" "$short_title" "$stale_badge"
    done
else
    echo -e "  \033[1;32m🎉 Inbox Zero! No PRs currently awaiting your review.\033[0m"
fi

# -----------------------------------------------------------------------------
# 2. YOUR OPEN PRs & REVIEW STATUS
# -----------------------------------------------------------------------------
echo -e "\n\033[1;33m🚀 YOUR OPEN PULL REQUESTS\033[0m"
local my_prs=$(gh search prs --author=@me --state=open --json repository,number,title,reviewDecision,updatedAt --jq '.[] | "\(.repository.nameWithOwner)\t#\(.number)\t\(.title)\t\(.reviewDecision)\t\(.updatedAt)"' 2>/dev/null)

if [[ -n "$my_prs" ]]; then
    printf "  \033[1;37m%-28s %-8s %-32s %-16s\033[0m\n" "REPO" "PR" "TITLE" "DECISION"
    echo "  -------------------------------------------------------------------------------"
    echo "$my_prs" | while IFS=$'\t' read -r repo pr_num title decision updated_at; do
        local status_badge="\033[1;33m⏳ IN REVIEW\033[0m"
        [[ "$decision" == "APPROVED" ]] && status_badge="\033[1;32m✅ APPROVED\033[0m"
        [[ "$decision" == "CHANGES_REQUESTED" ]] && status_badge="\033[1;31m❌ CHANGES REQ\033[0m"

        local short_title="${title[1,30]}"
        [[ ${#title} -gt 30 ]] && short_title="${short_title}…"
        printf "  \033[1;34m%-28s\033[0m \033[1;36m%-8s\033[0m %-32s %b\n" "${repo[1,27]}" "$pr_num" "$short_title" "$status_badge"
    done
else
    echo -e "  \033[0;37mNo open PRs authored by you.\033[0m"
fi

# -----------------------------------------------------------------------------
# 3. NOTIFICATIONS & MENTIONS
# -----------------------------------------------------------------------------
local notifs=$(gh api notifications --jq 'length' 2>/dev/null || echo "0")
local mentions=$(gh search issues --mentions=@me --state=open --json number --jq 'length' 2>/dev/null || echo "0")

echo -e "\n\033[1;33m📬 ACTIVITY & ALERTS\033[0m"
printf "  Unread Notifications : \033[1;37m%s\033[0m\n" "$notifs"
printf "  Open Mentions (@me)  : \033[1;37m%s\033[0m\n" "$mentions"

# -----------------------------------------------------------------------------
# 4. CURRENT REPO CONTEXT (if inside a git repo)
# -----------------------------------------------------------------------------
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "\n\033[1;33m📁 CURRENT REPOSITORY\033[0m"
    local repo_root=$(basename "$(git rev-parse --show-toplevel)")
    local branch=$(git branch --show-current 2>/dev/null || git rev-parse --short HEAD)
    local commits_today=$(git log --oneline --since="midnight" 2>/dev/null | wc -l | tr -d ' ')
    local commits_week=$(git log --oneline --since="7 days ago" 2>/dev/null | wc -l | tr -d ' ')
    local unpushed=$(git log --oneline @{u}..HEAD 2>/dev/null | wc -l | tr -d ' ')

    printf "  Repository : \033[1;32m%s\033[0m (\033[1;36m%s\033[0m)\n" "$repo_root" "$branch"
    printf "  Activity   : \033[1;37m%s commits today\033[0m, \033[1;37m%s this week\033[0m\n" "$commits_today" "$commits_week"
    if [[ "$unpushed" -gt 0 ]]; then
        printf "  Sync Status: \033[1;31m🚀 %s unpushed commits\033[0m\n" "$unpushed"
    else
        printf "  Sync Status: \033[1;32m✔ Up to date with remote\033[0m\n"
    fi
fi

# -----------------------------------------------------------------------------
# 5. MOST ACTIVE REPOSITORIES
# -----------------------------------------------------------------------------
echo -e "\n\033[1;33m🌟 RECENT ACTIVE REPOSITORIES\033[0m"
local recent_repos=$(gh repo list --limit 5 --json nameWithOwner,pushedAt,isPrivate --jq '.[] | "\(.nameWithOwner)\t\(.isPrivate)\t\(.pushedAt)"' 2>/dev/null)
if [[ -n "$recent_repos" ]]; then
    echo "$recent_repos" | while IFS=$'\t' read -r r_name is_priv pushed; do
        local vis="public"
        [[ "$is_priv" == "true" ]] && vis="private"
        local pushed_date="${pushed[1,10]}"
        printf "  • \033[1;34m%-32s\033[0m \033[0;37m(%s)\033[0m — Last push: %s\n" "$r_name" "$vis" "$pushed_date"
    done
else
    echo -e "  \033[0;37m(Run 'gh auth login' to view recent repositories)\033[0m"
fi

echo -e "\n\033[1;36m═══════════════════════════════════════════════════════════════════════\033[0m\n"
