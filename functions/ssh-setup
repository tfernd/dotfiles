# ============================================================================
# SSH Key Setup Wizard
# ============================================================================

echo -e "\n\033[1;36m=== SSH Key Setup ===\033[0m\n"
local git_name=$(git config --global user.name 2>/dev/null)
local git_email=$(git config --global user.email 2>/dev/null)
local email="${1:-$git_email}"

if [[ -z "$email" ]]; then
    echo -n "Enter your email for the SSH key: "
    read -r email
    [[ -z "$email" ]] && { echo "❌ Email is required. Run 'git-setup' first."; return 1 2>/dev/null || exit 1; }
fi

local key_comment="$email"
[[ -n "$git_name" ]] && key_comment="$git_name <$email>"

echo -e "  Comment: \033[1;33m$key_comment\033[0m\n"
local key_path="$HOME/.ssh/id_ed25519"

if [[ -f "$key_path" ]]; then
    echo -e "⚠️  Key already exists: \033[1;33m$key_path\033[0m"
    echo -n "Overwrite? (y/N): "
    read -r overwrite
    if [[ ! "$overwrite" =~ ^[yY] ]]; then
        echo "Keeping existing key."
        ssh-login
        return 0 2>/dev/null || exit 0
    fi
fi

echo -e "🔑 Generating ed25519 key..."
mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"

echo -n "Use a passphrase? (Y/n): "
read -r use_pass
if [[ "$use_pass" =~ ^[nN] ]]; then
    ssh-keygen -t ed25519 -C "$key_comment" -f "$key_path" -N "" || { echo "❌ Key generation failed."; return 1 2>/dev/null || exit 1; }
else
    while true; do
        ssh-keygen -t ed25519 -C "$key_comment" -f "$key_path" || { echo "❌ Key generation failed."; return 1 2>/dev/null || exit 1; }
        if ssh-keygen -y -P "" -f "$key_path" &>/dev/null; then
            echo -e "\n❌ \033[1;31mEmpty passphrase!\033[0m Trying again...\n"
            rm -f "$key_path" "${key_path}.pub"
            continue
        fi
        break
    done
fi

eval "$(ssh-agent -s)" &>/dev/null
ssh-add "$key_path" 2>/dev/null && echo "✅ SSH agent ready (key loaded)"

echo -e "\n\033[1;33m=== Your Public Key ===\033[0m\n"
cat "${key_path}.pub"
echo -e "\n📝 Add at: \033[1;36mhttps://github.com/settings/ssh/new\033[0m"
