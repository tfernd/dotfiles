// ============================================================================
// 🚀 ZELLIJ CONFIGURATION
// https://zellij.dev/documentation/configuration.html
// ============================================================================

// Theme
theme "catppuccin-mocha"

// Default layout ("default" includes the top tab-bar and interactive bottom help bar)
default_layout "default"

// Behavior
mouse_mode true
copy_on_select true
copy_command "xclip -selection clipboard"
copy_clipboard "system"
pane_frames true
simplified_ui false
on_force_close "detach"
auto_layout true
show_startup_tips false

// Scrollback buffer size
scroll_buffer_size 10000

// Mirror session on attach by default
attach_to_session true

// ----------------------------------------------------------------------------
// Custom Direct Keybindings (Single-key Alt shortcuts)
// ----------------------------------------------------------------------------
keybinds {
    shared_except "locked" {
        bind "Alt n" { NewPane; }
        bind "Alt x" { CloseFocus; }
        bind "Alt f" { ToggleFocusFullscreen; }
        bind "Alt w" { ToggleFloatingPanes; }
        bind "Alt t" { NewTab; }
        bind "Alt d" { Detach; }
        bind "Alt Left" "Alt h" { MoveFocus "Left"; }
        bind "Alt Right" "Alt l" { MoveFocus "Right"; }
        bind "Alt Down" "Alt j" { MoveFocus "Down"; }
        bind "Alt Up" "Alt k" { MoveFocus "Up"; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "PageUp" { PageScrollUp; }
        bind "PageDown" { PageScrollDown; }
    }
}
